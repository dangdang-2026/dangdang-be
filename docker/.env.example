# 서버 docker/.env 견본 — 값은 비워서 커밋, 진짜 값은 GitHub Secrets ENV_PROD에만
DOCKER_REPO=
DB_NAME=dangdang
DB_USER=dangdang
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 카드뉴스 이미지 (운영자). s3로 바꾸고 버킷과 키를 채운다
CARD_IMAGE_STORAGE=off
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HIRA_SERVICE_KEY=
HIRA_SYNC_ENABLED=false
